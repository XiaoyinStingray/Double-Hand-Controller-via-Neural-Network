# Normalize text files, keep binaries untouched
* text=auto

# Shell / PBS scripts must keep LF on the Linux cluster
*.sh  text eol=lf
*.pbs text eol=lf

*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.mp4  binary
*.avi  binary
*.mov  binary
*.onnx binary
*.pt   binary
*.pth  binary
*.npy  binary
*.npz  binary
*.zip  binary
